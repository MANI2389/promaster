rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure user-ownership validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profile Collection: users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Personalized Learning Plans: learningPlans/{userId}
    match /learningPlans/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 3. Daily Tasks Collection & Subcollection: dailyTasks/{userId}/tasks/{taskId}
    match /dailyTasks/{userId} {
      allow read, write: if isOwner(userId);

      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 4. Learning Progress & Metrics: progress/{userId}
    match /progress/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 5. AI Conversation Sessions: conversations/{userId}/messages/{messageId}
    match /conversations/{userId} {
      allow read, write: if isOwner(userId);

      match /messages/{messageId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 6. User Application Settings: settings/{userId}
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Default deny for all other collections and unauthenticated requests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
