# PROMASTER AI Backend Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control!

# Gemini API Key (Secret - Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Free-Tier Gemini Model
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15.0

# Groq Cloud Fallback (Optional high-speed backup provider - https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15.0

# Ollama Local Offline AI (Optional local inference - http://localhost:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=15.0

# Firebase Admin Service Account Key JSON Path (Optional in dev, required in production)
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
FIREBASE_PROJECT_ID=promaster-ai-core

# Environment: 'development', 'staging', 'production'
BACKEND_ENV=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Free-Tier Rate Limiting (requests per minute per user)
RATE_LIMIT_PER_MINUTE=15

# Maximum input characters & output tokens for free tier protection
MAX_INPUT_LENGTH=1500
MAX_OUTPUT_TOKENS=1024

# Comma-separated browser origins. Required for production web clients; leave empty for mobile-only deployments.
CORS_ALLOWED_ORIGINS=
